# Gemfile for the hirn documentation site.
#
# Built via GitHub Actions (see .github/workflows/pages.yml) so we run current
# Jekyll 4 + the latest Just the Docs, instead of the legacy `github-pages` gem
# which is pinned to Jekyll 3.9.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# Documentation theme: modern, responsive, built-in search + mermaid + dark mode.
gem "just-the-docs", "~> 0.10"

group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-relative-links", "~> 0.7"
end

# Windows / JRuby timezone data.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Faster file watching on Windows.
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]
